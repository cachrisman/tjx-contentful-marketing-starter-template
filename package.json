{
  "name": "template-marketing-webapp-nextjs",
  "description": "Contentful Marketing Starter — Next.js App Router (rebuilt)",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "analyze": "NODE_ENV=production next build --webpack",
    "check:preview-bundle": "node scripts/check-preview-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@contentful/content-source-maps": "^0.12.2",
    "@contentful/live-preview": "^4.9.0",
    "@contentful/rich-text-react-renderer": "^16.1.6",
    "@contentful/rich-text-types": "^17.2.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@ninetailed/experience.js-plugin-insights": "7.23.0",
    "@ninetailed/experience.js-plugin-preview": "7.23.0",
    "@ninetailed/experience.js-plugin-privacy": "7.23.0",
    "@ninetailed/experience.js-react": "7.23.0",
    "@ninetailed/experience.js-shared": "7.23.0",
    "@ninetailed/experience.js-utils": "7.23.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "graphql": "^16.12.0",
    "next": "^16.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/near-operation-file-preset": "^5.2.0",
    "@graphql-codegen/typed-document-node": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-config-prettier": "^10.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
