# Copy to .env.local for local development (never commit .env.local)

CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Used by /api/draft/* routes to enable preview mode
CONTENTFUL_PREVIEW_SECRET=

# Optional; default GraphQL environment is master. Must match the Live Preview provider.
# CONTENTFUL_ENVIRONMENT=master

# Set to 1 to log Live Preview SDK messages in the browser console.
# NEXT_PUBLIC_CONTENTFUL_LIVE_PREVIEW_DEBUG=1

# Public site URL for metadata, sitemap, and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
