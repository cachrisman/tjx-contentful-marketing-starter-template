# Copy to .env.local for local development (never commit .env.local)

CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Used by /api/draft/* routes to enable preview mode
CONTENTFUL_PREVIEW_SECRET=

# Optional; default GraphQL environment is master. Must match the Live Preview provider.
# CONTENTFUL_ENVIRONMENT=master

# Set to 1 to log Live Preview SDK messages in the browser console.
# NEXT_PUBLIC_CONTENTFUL_LIVE_PREVIEW_DEBUG=1

# Public site URL for metadata, sitemap, and Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Ninetailed (Contentful Personalization) ---
# Public Experience SDK Client ID for the Personalization workspace.
# Leave blank to skip mounting NinetailedProvider entirely (baseline rendering).
NEXT_PUBLIC_NINETAILED_CLIENT_ID=
# Environment name as configured in the Personalization web app
# (NOT only `main` / `development` — must match the install UI string verbatim).
NEXT_PUBLIC_NINETAILED_ENVIRONMENT=main

# Server-only secret used to HMAC-sign the internal selection header set by
# `src/proxy.ts` and read by Server Components. Generate a random 32+ byte value.
# When unset, the proxy still passes through baseline (no selection header forwarded).
NINETAILED_SELECTION_SECRET=

# Optional: explicit Experience API URL override (defaults to https://experience.ninetailed.co)
# NINETAILED_API_URL=https://experience.ninetailed.co
# Optional: edge-budget for the Experience API call from `src/proxy.ts`. POC default 500ms.
# NINETAILED_PROXY_TIMEOUT_MS=500

# Pre-consent allowlist (Phase 1 Privacy plugin) — see plan §Locked Phase 0.
# Set to `1` to start with post-consent allowlist (POC dev shortcut; do not use in prod).
# NEXT_PUBLIC_NINETAILED_DEFAULT_CONSENT=0

# JSON array of Contentful-shaped Experience entries for the hero (server-only).
# Use "__BASELINE_ID__" as a placeholder; it is replaced with the hero entry sys.id at runtime.
# See `loadHeroExperiencesFromEnv` in `src/lib/personalization/hero-experiences-from-env.ts`.
# NINETAILED_HERO_EXPERIENCES_JSON=

# Comma-separated slugs after locale for Ninetailed proxy (Experience API).
# Omit or set to `*` for wildcard: every hero-shaped URL `/{locale}` and
# `/{locale}/{slug}` is evaluated. Example restrict: `home,about-us`
# NINETAILED_ESR_SLUGS=

# Draft/preview-only (read when Contentful Draft Mode / preview is active):
# JSON arrays for `NinetailedPreviewPlugin` — experiences must match Contentful
# NtExperience API entries; use `ExperienceMapper` rules (see Ninetailed preview-plugin docs).
# NINETAILED_PREVIEW_EXPERIENCES_JSON=
# Audiences: `[{ "id": "…", "name": "…", "description": "…" }]`
# NINETAILED_PREVIEW_AUDIENCES_JSON=
